# SchoolHub frontend monorepo — copy to .env and fill in.
# Only NEXT_PUBLIC_* values are exposed to the browser; everything else stays server-side.
# Real .env files are git-ignored; secrets are never committed (gitleaks runs in CI).

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# Root of the SchoolHub REST API, without a trailing slash. Includes /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Platform apex domain used for tenant wildcard subdomains (<slug>.<platform-domain>).
NEXT_PUBLIC_PLATFORM_DOMAIN=schoolhub.local

# ---------------------------------------------------------------------------
# apps/dashboard
# ---------------------------------------------------------------------------
# Public origin the dashboard is served from (used for absolute URLs / redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Sentry DSN for browser error reporting. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Default locale for next-intl when the tenant has no locale preference.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# apps/website (public multi-tenant renderer — READ ONLY)
# ---------------------------------------------------------------------------
# Server-side API base URL used with the machine token (never exposed to the browser).
API_BASE_URL=http://localhost:8000/api/v1
# Scoped, read-only machine token limited to `website.public-content.view`.
WEBSITE_MACHINE_TOKEN=replace-with-scoped-read-only-machine-token
# Public API origin the BROWSER posts contact/admission forms to (no token involved).
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
# ISR safety-net revalidation window in seconds (publish webhooks do the real invalidation).
CONTENT_REVALIDATE_SECONDS=300
# Shared secret for the HMAC-SHA256 signature on the publish/revalidate webhook.
REVALIDATE_WEBHOOK_SECRET=replace-with-revalidate-webhook-secret

# --- Context7 (documentation lookup for AI assistants) ---
# Referenced by .mcp.json. Get a key at https://context7.com/dashboard and export
# it in your shell; it is deliberately not stored in the committed config.
CONTEXT7_API_KEY=
