# =============================================================================
# Copy to terraform.tfvars (git-ignored) and fill in.
#
# NO SECRET VALUES BELONG IN THIS FILE — only ARNs, names and IDs. Every actual
# secret lives in Secrets Manager and is referenced here by ARN. If you find
# yourself pasting a password, stop: the secret is created by
# scripts/rotate-secrets.sh and only its ARN comes back here.
# =============================================================================

# Region for everything except the CloudFront certificate, which ACM forces to
# us-east-1 (handled by the aws.us_east_1 provider alias in main.tf).
# me-central-1 or ap-south-1 (D20); validated in variables.tf.
aws_region = "me-central-1"

# The staging platform domain. Tenant sites are <slug>.staging.schoolhub.example.
# Source: whatever you registered; must match the hosted zone below.
platform_domain = "staging.schoolhub.example"

# Proxies in front of the API that append to X-Forwarded-For (CloudFront + ALB = 2,
# ALB only = 1, direct = 0). Wrong values make per-IP throttles and stored IPs
# spoofable or wrong; the API refuses to boot without it. 2 is correct here because the
# ALB's security group accepts CloudFront's origin-facing addresses only.
num_proxies = 2

# The hostname schools' custom domains CNAME to (the edge serving tenant sites). Changing
# it later lapses every active domain unless the old name keeps resolving (module doc §20).
website_cname_target = "sites.staging.schoolhub.example"

# Route 53 hosted zone ID for platform_domain.
# Source: `aws route53 list-hosted-zones-by-name --dns-name staging.schoolhub.example`
# Created out of band — Terraform does not manage the zone, because recreating a
# zone changes its nameservers and takes the whole domain down.
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# VPC CIDR. Must not overlap production (10.30.0.0/16) or any office VPN range.
vpc_cidr = "10.20.0.0/16"

# -----------------------------------------------------------------------------
# Images. Immutable, tagged with the git SHA — never :latest.
# Source: the ECR push step of each repo's CI run.
# CI overrides these with -var on every deploy; the values here are the
# bootstrap so the first apply has something to run.
# -----------------------------------------------------------------------------
# Bootstrap output `ecr_registry`. Images are <registry>/schoolhub/<api|dashboard|website>:<image_tag>.
ecr_registry = "123456789012.dkr.ecr.me-central-1.amazonaws.com"
# Full 40-hex git SHA of the first images (the build-only run in deploy.md).
image_tag = "<40-hex git SHA>"

# -----------------------------------------------------------------------------
# Buckets. Globally unique across all of S3, so include the account or a suffix
# if these collide.
# -----------------------------------------------------------------------------
uploads_bucket_name = "schoolhub-staging-uploads"
backup_bucket_name  = "schoolhub-staging-backups"

# -----------------------------------------------------------------------------
# Secret ARNs, not secret values.
# Source: `aws secretsmanager list-secrets --query 'SecretList[].[Name,ARN]'`
# The secrets themselves are created and rotated by scripts/rotate-secrets.sh.
# -----------------------------------------------------------------------------

# DJANGO_SECRET_KEY. Rotating this invalidates every session and signed token —
# schedule it, do not do it on a Friday.
django_secret_key_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:schoolhub-staging/django/secret-key-AbCdEf"

# INTEGRATIONS_ENCRYPTION_KEYS: comma-separated Fernet keys, newest first. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())".
integrations_encryption_keys_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:schoolhub-staging/integrations/encryption-keys-AbCdEf"

# DATABASE_URL for the APPLICATION role only: schoolhub_app, directly on 5432 in v1
# (no pooler, ADR-0040). Never the RDS master URL — the app must not be able to
# run DDL. Printed by infra/scripts/bootstrap-secrets.sh.
app_database_url_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:schoolhub-staging/db/app-url-AbCdEf"

# The migrator role's URL, directly on 5432; only the migrate task reads it.
# Printed by `infra/scripts/bootstrap-secrets.sh`.
migrator_database_url_arn = "arn:aws:secretsmanager:me-central-1:123456789012:secret:schoolhub-staging/db/migrator-url-AbCdEf"

# The three role passwords the db-bootstrap task applies.
# Printed by `infra/scripts/bootstrap-secrets.sh`.
db_role_password_arns = {
  app      = "arn:aws:secretsmanager:me-central-1:123456789012:secret:schoolhub-staging/db/app-password-AbCdEf"
  migrator = "arn:aws:secretsmanager:me-central-1:123456789012:secret:schoolhub-staging/db/migrator-password-AbCdEf"
  readonly = "arn:aws:secretsmanager:me-central-1:123456789012:secret:schoolhub-staging/db/readonly-password-AbCdEf"
}

# The website renderer's secrets. The renderer's token must be in the API's list; see
# infra/runbooks/rotate-website-secrets.md. The revalidate secret is one value under two names
# (the API's WEBSITE_REVALIDATE_SECRET, the renderer's REVALIDATE_WEBHOOK_SECRET).
website_machine_tokens_arn    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:schoolhub-staging/website/machine-tokens-AbCdEf"
website_machine_token_arn     = "arn:aws:secretsmanager:us-east-1:123456789012:secret:schoolhub-staging/website/machine-token-AbCdEf"
website_revalidate_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:schoolhub-staging/website/revalidate-secret-AbCdEf"

# Sentry DSN for the staging project. Leave "" to run without error tracking.
# Source: Sentry -> Settings -> Projects -> schoolhub-staging -> Client Keys.
sentry_dsn_arn = ""

# -----------------------------------------------------------------------------
# Alerting. Staging notifies a Slack channel and pages nobody.
# Source: `aws sns list-topics`
# -----------------------------------------------------------------------------
alarm_sns_topic_arns = [
  "arn:aws:sns:us-east-1:123456789012:schoolhub-staging-alerts",
]

tags = {
  Owner      = "platform"
  CostCenter = "engineering"
}
