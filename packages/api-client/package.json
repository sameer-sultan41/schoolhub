{
  "name": "@schoolhub/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed fetch client for the SchoolHub REST API \u2014 regenerated from the published OpenAPI spec",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf .turbo coverage *.tsbuildinfo",
    "generate": "openapi-typescript ../../apps/api/openapi.yaml -o src/schema.d.ts"
  },
  "dependencies": {
    "@schoolhub/types": "workspace:*"
  },
  "devDependencies": {
    "@schoolhub/config": "workspace:*",
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "jest": "^30.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
