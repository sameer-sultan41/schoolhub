{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // No `rootDir` — see packages/api-client/tsconfig.json for why.
    // `@testing-library/jest-dom` and `jest-axe` are listed so their matchers
    // (toBeDisabled, toHaveAttribute, toHaveNoViolations…) type-check: jest.setup.ts
    // imports them at runtime but sits outside `include`. `node` is here for
    // styles/theme.test.ts, which reads theme.css off disk — the token layer is CSS,
    // and jest maps every `.css` import to a stub that cannot tell you what it declares.
    "types": ["jest", "node", "@testing-library/jest-dom", "jest-axe"],
    "paths": {
      "@schoolhub/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // layouts/ and partials/ are Metronic's own demo-page scaffolding, copied in alongside
  // the primitive library but not yet wired into anything this package exports — they
  // use Metronic's own Next.js app's path alias (`@/components/ui/...`) and import
  // straight from `next/link`, neither of which resolves in this package's own
  // tsconfig. Excluded until (if) they're actually adopted, not deleted, per the plan.
  "exclude": [
    "node_modules",
    "coverage",
    ".turbo",
    "src/components/layouts",
    "src/components/partials",
    "src/components/image-input",
    "src/components/keenicons"
  ]
}
