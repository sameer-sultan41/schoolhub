{
  "name": "schoolhub-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SchoolHub frontend monorepo \u2014 admin dashboard + multi-tenant public website renderer",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md,css}\"",
    "e2e": "pnpm --filter @schoolhub/e2e e2e",
    "e2e:ui": "pnpm --filter @schoolhub/e2e e2e:ui",
    "e2e:live": "pnpm --filter @schoolhub/e2e e2e:live",
    "e2e:install": "pnpm --filter @schoolhub/e2e e2e:install"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "turbo": "^2.10.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
