# SchoolHub E2E — every value has a working local default; copy only what you override.
#   cp e2e/.env.example e2e/.env

# --- Targets (mocked + live lanes) ---
E2E_DASHBOARD_URL=http://localhost:3000
E2E_WEBSITE_URL=http://localhost:3001
E2E_PLATFORM_DOMAIN=localhost

# API origin the apps are pointed at.
# Mocked lane: keep a port nothing listens on, so an un-stubbed call fails loudly.
# Live lane:   point at the running Django API, e.g. http://localhost:8000/api/v1
E2E_API_BASE_URL=http://127.0.0.1:4010/api/v1

# --- Live lane only (tests/live). Ignored by the mocked projects. ---
E2E_LIVE_TENANT_SLUG=e2e-school
E2E_LIVE_OTHER_TENANT_SLUG=e2e-other-school
E2E_LIVE_ADMIN_IDENTIFIER=e2e-admin@schoolhub.test
E2E_LIVE_ADMIN_PASSWORD=change-me-locally

# Skip Playwright's managed dev servers when you are already running them yourself.
# E2E_NO_SERVER=1
