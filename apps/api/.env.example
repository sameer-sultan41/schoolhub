# Copy to .env for local development. Never commit the real file.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-50
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# Apex domain tenants are served under: <slug>.<platform-domain>.
PLATFORM_DOMAIN=localhost
# Where the API is reachable from outside; payment-provider callbacks are built on it.
# Required in production (https://api.<platform-domain>); dev defaults to the compose API.
API_PUBLIC_URL=http://api.localhost:8000

# --- Integrations ---
# Comma-separated Fernet keys, newest first; they encrypt each school's payment-gateway
# credentials. Leave empty in development: config.settings.dev falls back to a public
# dev-only key. Production requires its own. Generate one:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEYS=

# --- Database ---
# The application role must NOT have BYPASSRLS and must not own the tables,
# or Row-Level Security silently stops isolating tenants.
DATABASE_URL=postgres://schoolhub_app:schoolhub@localhost:6432/schoolhub
# Seconds to keep a connection open. 0 = close per request (safe behind PgBouncer).
DB_CONN_MAX_AGE=0

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS / CSRF (production) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Object storage (S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
# The address browsers are sent to for signed links, when it differs from S3_ENDPOINT_URL
# (e.g. MinIO reached at a different host from inside Docker). Empty = same as the endpoint.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET_NAME=schoolhub-dev
S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Lifetime of signed inline display links (seconds).
FILE_DISPLAY_URL_TTL_SECONDS=3600

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@schoolhub.local

# --- Rate limits (api-architecture.md §2.5) ---
# Read by config.settings.dev only (local and e2e-live); production settings keep these
# values fixed and ignore the variables.
THROTTLE_RATE_TENANT=600/min
THROTTLE_RATE_USER=60/min
THROTTLE_RATE_ANON=20/min
THROTTLE_RATE_AUTH=10/min
THROTTLE_RATE_PUBLIC_FORM=5/min
THROTTLE_RATE_PASSWORD_RESET_EMAIL=5/hour
THROTTLE_RATE_PASSWORD_RESET_IP=20/hour
THROTTLE_RATE_INVITATION_IP=60/hour

# --- AI gateway (planned — read once core/ai lands) ---
# Server-side only. Never expose to a browser or mobile client.
ANTHROPIC_API_KEY=
AI_MONTHLY_TOKEN_BUDGET_DEFAULT=1000000
