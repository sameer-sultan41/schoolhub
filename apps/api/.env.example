# Copy to .env for local development. Never commit the real file.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-50
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# Apex domain tenants are served under: <slug>.<platform-domain>.
PLATFORM_DOMAIN=localhost

# --- Database ---
# The application role must NOT have BYPASSRLS and must not own the tables,
# or Row-Level Security silently stops isolating tenants.
DATABASE_URL=postgres://schoolhub_app:schoolhub@localhost:6432/schoolhub
# Seconds to keep a connection open. 0 = close per request (safe behind PgBouncer).
DB_CONN_MAX_AGE=0

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS / CSRF (production) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Object storage (S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
# The address browsers are sent to for signed links, when it differs from S3_ENDPOINT_URL
# (e.g. MinIO reached at a different host from inside Docker). Empty = same as the endpoint.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET_NAME=schoolhub-dev
S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Lifetime of signed inline display links (seconds).
FILE_DISPLAY_URL_TTL_SECONDS=3600

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@schoolhub.local

# --- AI gateway (planned — read once core/ai lands) ---
# Server-side only. Never expose to a browser or mobile client.
ANTHROPIC_API_KEY=
AI_MONTHLY_TOKEN_BUDGET_DEFAULT=1000000
