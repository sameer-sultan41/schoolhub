# =============================================================================
# SchoolHub — local development environment.
#
#   cp .env.example .env      # .env is git-ignored; NEVER commit it
#
# Every variable the compose stack reads is listed here with a dummy value and a
# note on where the real value comes from. Values marked "local only" are safe to
# invent; anything marked with a provider is issued by that provider and must
# come from the platform secret manager in staging/production, never from a file.
#
# Spec: schoolhub-srd/docs/02-architecture/hosting-deployment.md §5 (Secrets)
#       schoolhub-srd/docs/02-architecture/repo-structure.md §4 (12-factor config)
# =============================================================================

# -----------------------------------------------------------------------------
# Repository locations
# Where your sibling checkouts live, relative to compose/ or absolute.
# -----------------------------------------------------------------------------
API_REPO_PATH=../../schoolhub-api-v2
FRONTEND_REPO_PATH=../../schoolhub-web
# Multi-stage build target: "dev" mounts source and hot-reloads, "prod" does not.
API_BUILD_TARGET=dev
FRONTEND_BUILD_TARGET=dev

# -----------------------------------------------------------------------------
# Runtime base images.
#
# Pinned HERE, in infra, rather than inside each application Dockerfile, so one
# edit moves every environment at once and dev/CI/production cannot drift apart.
# The application Dockerfiles take these as build args.
# -----------------------------------------------------------------------------
PYTHON_IMAGE=python:3.14-slim
NODE_IMAGE=node:24-alpine

# -----------------------------------------------------------------------------
# PostgreSQL 18
# Local only. In staging/production the managed provider issues these and rotates
# them; the app never sees the superuser credential at all.
# -----------------------------------------------------------------------------
POSTGRES_DB=schoolhub
POSTGRES_PORT=5432

# Superuser — used ONLY by the container entrypoint and the init scripts.
# No application, script or human workflow may connect as this role.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-dev-superuser-change-me

# Application role. Connects through PgBouncer. Owns nothing, has no BYPASSRLS.
# This is the role whose RLS binding protects every tenant — see
# postgres/init/02-app-role.sql before changing anything about it.
APP_DB_USER=schoolhub_app
APP_DB_PASSWORD=local-dev-app-change-me

# Migration role. Owns the schema and runs `manage.py migrate`. Connects DIRECTLY
# to Postgres (port 5432), not through the pooler: DDL and CONCURRENTLY index
# builds are session-scoped and are incompatible with transaction pooling.
MIGRATION_DB_USER=schoolhub_migrator
MIGRATION_DB_PASSWORD=local-dev-migrator-change-me

# Audited read-only role for platform-level aggregate reporting. Also has no
# BYPASSRLS: platform reporting aggregates metrics, never row-level school data.
READONLY_DB_USER=schoolhub_readonly
READONLY_DB_PASSWORD=local-dev-readonly-change-me

# -----------------------------------------------------------------------------
# PgBouncer (transaction pooling)
#
# The .ini lives at postgres/pgbouncer/pgbouncer.ini. Credentials are matched
# against postgres/pgbouncer/userlist.txt, which is git-ignored and which
# scripts/seed-dev.sh generates for you from the SCRAM verifiers PostgreSQL
# actually computed — the only way to be sure both sides agree. Run that script
# before starting pgbouncer, or the container will not authenticate anyone.
#
# Transaction pooling is a tenant-isolation control, not a performance knob:
# application code must use `SET LOCAL app.tenant_id` inside a transaction and
# never a session-level `SET`. See that .ini's header.
# -----------------------------------------------------------------------------
PGBOUNCER_PORT=6432

# -----------------------------------------------------------------------------
# Redis 8 — cache, Celery broker, rate limiting.
# Disposable: never store anything here that cannot be recomputed.
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Django
# DJANGO_SECRET_KEY: local only. In staging/production this comes from the
# platform secret manager and is rotated on personnel change or exposure.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=local-dev-insecure-generate-your-own
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.localhost,api
API_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Domains and multi-tenancy
# Dev resolves *.localhost automatically on macOS and modern Linux. Tenant sites
# are <slug>.localhost:3001; the dashboard is app.localhost:3000.
# Staging: staging.schoolhub.example — Production: schoolhub.example (wildcard
# record *.<domain> plus per-tenant verified custom domains).
# -----------------------------------------------------------------------------
PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_API_BASE_URL=http://api.localhost:8000/api/v1
DASHBOARD_PORT=3000
WEBSITE_PORT=3001

# Read-only machine token the website renderer uses to fetch published public
# content. Issued by the API (platform-admin module) per environment.
PUBLIC_CONTENT_TOKEN=local-dev-public-content-token

# Shared secret for the API → renderer on-demand ISR revalidation webhook.
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=local-dev-revalidate-secret

# -----------------------------------------------------------------------------
# Object storage (S3-compatible)
# Local: MinIO. Staging/production: AWS S3 or Cloudflare R2 — credentials issued
# by that provider, scoped to the single bucket, injected by the secret manager.
# Keys are always prefixed tenants/{tenant_id}/ and served via signed URLs.
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=schoolhub
MINIO_ROOT_PASSWORD=local-dev-minio-change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_NAME=schoolhub-dev
S3_REGION_NAME=us-east-1

# -----------------------------------------------------------------------------
# Email
# Local: Mailpit catches everything, nothing leaves the machine.
# Staging: provider sandbox credentials. Production: live provider credentials
# from the secret manager (see docs/02-architecture/notifications.md).
# -----------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
DEFAULT_FROM_EMAIL=no-reply@schoolhub.localhost

# -----------------------------------------------------------------------------
# Third-party services
# All optional locally — leave blank and the corresponding integration is a no-op.
# -----------------------------------------------------------------------------
# Sentry DSN — from sentry.io project settings. Empty disables error reporting.
SENTRY_DSN=
# Anthropic API key — console.anthropic.com. Server-side only: it must never be
# exposed to a browser, and every AI call goes through core/ai's gateway so that
# per-tenant budgets and audit logging apply.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Backup / restore scripts (scripts/backup.sh, scripts/restore.sh)
# Local defaults write to ./backups. In staging/production these point at the
# encrypted, separate-account backup bucket and the values come from the deploy
# environment, not from a file.
# -----------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_S3_BUCKET=
# age recipient public key used to encrypt backups before upload. The matching
# private key lives in the secret manager and with named operators only.
BACKUP_AGE_RECIPIENT=
# PITR window enforced by the retention policy, in days (spec: ≥ 30).
BACKUP_PITR_DAYS=30
